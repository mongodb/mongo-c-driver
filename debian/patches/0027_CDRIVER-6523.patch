diff --git a/src/libmongoc/src/mongoc/mongoc-cursor.c b/src/libmongoc/src/mongoc/mongoc-cursor.c
index 3bf5d8de18..097088e7c9 100644
--- a/src/libmongoc/src/mongoc/mongoc-cursor.c
+++ b/src/libmongoc/src/mongoc/mongoc-cursor.c
@@ -1105,15 +1105,20 @@ retry:
       bson_copy_to (reply, &cursor->error_doc);
    }
 
-   /* Read and Write Concern Spec: "Drivers SHOULD parse server replies for a
-    * "writeConcernError" field and report the error only in command-specific
-    * helper methods that take a separate write concern parameter or an options
-    * parameter that may contain a write concern option.
+   /* Read and Write Concern Spec: "Drivers MUST parse server replies for a
+    * "writeConcernError" field and report the error in all driver methods that
+    * send a server command that may include a `WriteConcern`, excluding
+    * `abortTransaction` and generic command methods."
     *
-    * Only command helpers with names like "_with_write_concern" can create
-    * cursors with a non-NULL write_concern field.
+    * Of the commands sent by cursors, only "aggregate" may include a write
+    * concern, whether passed in opts or inherited (an inherited write concern
+    * is applied to the command via cursor->write_concern above). Such an
+    * aggregate has $out or $merge, which _mongoc_aggregate marks with
+    * is_aggr_with_write_stage, so check the reply if it is set. Generic
+    * command methods (e.g. mongoc_cursor_new_from_command_reply_with_opts)
+    * create cursors without the flag set and are excluded per the spec.
     */
-   if (ret && cursor->write_concern) {
+   if (ret && cursor->is_aggr_with_write_stage) {
       ret = !_mongoc_parse_wc_err (reply, &cursor->error);
    }
 
@@ -1359,6 +1364,7 @@ mongoc_cursor_clone (const mongoc_cursor_t *cursor)
    _clone->nslen = cursor->nslen;
    _clone->dblen = cursor->dblen;
    _clone->explicit_session = cursor->explicit_session;
+   _clone->is_aggr_with_write_stage = cursor->is_aggr_with_write_stage;
 
    if (cursor->read_prefs) {
       _clone->read_prefs = mongoc_read_prefs_copy (cursor->read_prefs);
diff --git a/src/libmongoc/src/mongoc/mongoc-gridfs-bucket-file.c b/src/libmongoc/src/mongoc/mongoc-gridfs-bucket-file.c
index 5f3219a937..341f5abb74 100644
--- a/src/libmongoc/src/mongoc/mongoc-gridfs-bucket-file.c
+++ b/src/libmongoc/src/mongoc/mongoc-gridfs-bucket-file.c
@@ -126,6 +126,9 @@ _mongoc_gridfs_bucket_create_indexes (mongoc_gridfs_bucket_t *bucket, bson_error
  *
  *--------------------------------------------------------------------------
  */
+static bool
+_mongoc_gridfs_bucket_write_chunk (mongoc_gridfs_bucket_file_t *file) BSON_GNUC_WARN_UNUSED_RESULT;
+
 static bool
 _mongoc_gridfs_bucket_write_chunk (mongoc_gridfs_bucket_file_t *file)
 {
@@ -350,7 +353,10 @@ _mongoc_gridfs_bucket_file_writev (mongoc_gridfs_bucket_file_t *file, const mong
 
          if (file->in_buffer == chunk_size) {
             /* Buffer is filled, write the chunk */
-            _mongoc_gridfs_bucket_write_chunk (file);
+            if (!_mongoc_gridfs_bucket_write_chunk (file)) {
+               /* Error is set on file. */
+               return -1;
+            }
          }
       }
    }
@@ -445,7 +451,10 @@ _mongoc_gridfs_bucket_file_save (mongoc_gridfs_bucket_file_t *file)
 
    if (file->in_buffer != 0) {
       length += file->in_buffer;
-      _mongoc_gridfs_bucket_write_chunk (file);
+      if (!_mongoc_gridfs_bucket_write_chunk (file)) {
+         /* Error is set on file. */
+         return false;
+      }
    }
 
    file->length = length;
diff --git a/src/libmongoc/src/mongoc/mongoc-gridfs-bucket.c b/src/libmongoc/src/mongoc/mongoc-gridfs-bucket.c
index 5da5420685..d7fdf164a5 100644
--- a/src/libmongoc/src/mongoc/mongoc-gridfs-bucket.c
+++ b/src/libmongoc/src/mongoc/mongoc-gridfs-bucket.c
@@ -230,6 +230,8 @@ mongoc_gridfs_bucket_upload_from_stream_with_id (mongoc_gridfs_bucket_t *bucket,
    ssize_t bytes_read;
    ssize_t bytes_written;
    char buf[512];
+   /* `mongoc_gridfs_bucket_stream_error` asserts on a non-NULL error. */
+   bson_error_t local_error;
 
    BSON_ASSERT (bucket);
    BSON_ASSERT (file_id);
@@ -245,7 +247,7 @@ mongoc_gridfs_bucket_upload_from_stream_with_id (mongoc_gridfs_bucket_t *bucket,
    while ((bytes_read = mongoc_stream_read (source, buf, 512, 1, 0)) > 0) {
       bytes_written = mongoc_stream_write (upload_stream, buf, bytes_read, 0);
       if (bytes_written < 0) {
-         BSON_ASSERT (mongoc_gridfs_bucket_stream_error (upload_stream, error));
+         BSON_ASSERT (mongoc_gridfs_bucket_stream_error (upload_stream, error ? error : &local_error));
          mongoc_gridfs_bucket_abort_upload (upload_stream);
          mongoc_stream_destroy (upload_stream);
          return false;
@@ -258,10 +260,19 @@ mongoc_gridfs_bucket_upload_from_stream_with_id (mongoc_gridfs_bucket_t *bucket,
          error, MONGOC_ERROR_GRIDFS, MONGOC_ERROR_GRIDFS_BUCKET_STREAM, "Error occurred on the provided stream.");
       mongoc_stream_destroy (upload_stream);
       return false;
-   } else {
+   }
+
+   /* Explicitly call `mongoc_stream_close` to surface an error on final writes. */
+   if (mongoc_stream_close (upload_stream) != 0) {
+      BSON_ASSERT (mongoc_gridfs_bucket_stream_error (upload_stream, error ? error : &local_error));
+      /* Per the GridFS spec, do not attempt to clean up orphaned chunks on error. */
+      /* `mongoc_stream_destroy` will not save the file since an error is set on it. */
       mongoc_stream_destroy (upload_stream);
-      return true;
+      return false;
    }
+
+   mongoc_stream_destroy (upload_stream);
+   return true;
 }
 
 bool
